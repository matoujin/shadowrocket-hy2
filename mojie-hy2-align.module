#!name=魔戒 HY2 对齐 Mac
#!desc=Grok Bot/Cursor/x.ai 强制直连（开代理会挂）；其余外网 HY2，失败回落 PROXY/直连。叠在魔戒订阅上用。
#!system=ios

[Proxy Group]
hy2节点 = url-test,url=http://www.gstatic.com/generate_204,interval=30,tolerance=30,timeout=3,policy-regex-filter=(?i)HY2
hy2自动选择 = fallback,hy2节点,PROXY,DIRECT,url=http://www.gstatic.com/generate_204,interval=30,timeout=3
HY2自动选择 = fallback,hy2节点,PROXY,DIRECT,url=http://www.gstatic.com/generate_204,interval=30,timeout=3

[Rule]
# 0. Grok Bot 相关：开代理会挂、关代理正常 → 强制直连（放最前）
DOMAIN-SUFFIX,cursor.sh,DIRECT
DOMAIN-SUFFIX,cursor.com,DIRECT
DOMAIN-SUFFIX,cursorapi.com,DIRECT
DOMAIN-SUFFIX,cursor-cdn.com,DIRECT
DOMAIN-KEYWORD,cursor,DIRECT
DOMAIN-SUFFIX,anysphere.co,DIRECT
DOMAIN-SUFFIX,grok.com,DIRECT
DOMAIN-KEYWORD,grok,DIRECT
DOMAIN-SUFFIX,x.ai,DIRECT
DOMAIN-SUFFIX,workos.com,DIRECT
DOMAIN-SUFFIX,sentry.io,DIRECT
DOMAIN-SUFFIX,dmxapi.cn,DIRECT
DOMAIN-SUFFIX,dmxapi.com,DIRECT
DOMAIN-KEYWORD,dmxapi,DIRECT

