#!name=魔戒 HY2 对齐 Mac
#!desc=强制 Grok/Cursor/xAI 走 hy2自动选择；须叠在魔戒订阅上（勿单独当完整配置）。变慢时手动选香港HK-HY2
#!system=ios

[Proxy Group]
hy2自动选择 = url-test,url=http://www.gstatic.com/generate_204,interval=30,tolerance=30,timeout=3,policy-regex-filter=(?i)HY2
HY2自动选择 = url-test,url=http://www.gstatic.com/generate_204,interval=30,tolerance=30,timeout=3,policy-regex-filter=(?i)HY2

